# ── Servidor ─────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Base de Dados ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=economia_historia

# ── JWT ───────────────────────────────────────────────────────────────
# OBRIGATÓRIO em produção: muda para uma string longa e aleatória
# Exemplo: openssl rand -hex 64
JWT_SECRET=MUDA_ISTO_EM_PRODUCAO
JWT_EXPIRES_IN=7d

# ── Frontend (usado nos links dos emails) ─────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Email SMTP (opcional — sem estas vars usa logs/emails.log) ────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=fausm1277@gmail.com
EMAIL_PASS=inqdhrkvugoqpxil
EMAIL_FROM=Educação Interativa Angola <noreply@educacaoangola.ao>

# Ignora erros de certificado SSL em desenvolvimento (ex: XAMPP)
NODE_TLS_REJECT_UNAUTHORIZED=0